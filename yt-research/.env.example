# YouTube Data API v3 key. Restrict it to "YouTube Data API v3" in Google Cloud.
# Same Google Cloud project as Comment Copilot, so both share the 10,000 units/day quota.
YOUTUBE_API_KEY=

# Long random secret that gates the MCP endpoint (at least 32 characters).
# Generate one with: openssl rand -hex 32
MCP_ACCESS_TOKEN=
